theorem leaves_length_K : leaves.length = 8815 := by decide +kernel

theorem all_leaves : ∀ l ∈ leaves, leafOK ctxLit l = true := by
  intro l hl
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hl
  have h := all_leaves_lt i (by rw [← leaves_length_K]; exact hi)
  rwa [List.getD_eq_getElem _ _ hi] at h

theorem chain_okK : chainOK 10000000000 30 leaves 210000000000 0 = true := by decide +kernel

theorem leavesOK_full_K : leavesOK (mkCtx iLoNum 128) 10000000000 30 leaves 210000000000 0 = true := by
  rw [TPCore.TPK.ctx_eq]
  exact leavesOK_of_chain ctxLit leaves _ _ _ _ chain_okK all_leaves

theorem certHyp_K : CertHyp Qc cR m0 NN eR GR sR :=
  certHyp_of_checks energy_okK TPCore.TPK.budget_okK
    (by rw [TPCore.TPK.ctx_eq]; exact of_decide_eq_true TPCore.TPK.left_tail_okK)
    (by rw [TPCore.TPK.ctx_eq]; exact of_decide_eq_true TPCore.TPK.right_tail_okK) leavesOK_full_K

end TPMahler.Cert

